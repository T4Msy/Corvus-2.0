      "id": "download-audio-corvus2",
      "name": "Baixar Áudio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [272, 320]
    },
    {
      "parameters": {
        "jsCode": "// Renomeia o binário para uma extensão que a OpenAI aceita. WhatsApp manda\n// .opus, que a OpenAI recusa pelo nome (mesmo sendo Ogg/Opus por dentro). O app\n// envia em body.filename o nome já normalizado (ex.: audio.ogg).\nconst filename = ($('Webhook Transcribe').first().json.body.filename || 'audio.ogg').toString();\nconst ext = filename.includes('.') ? filename.split('.').pop() : 'ogg';\nconst items = $input.all();\nfor (const item of items) {\n  if (item.binary && item.binary.data) {\n    item.binary.data.fileName = filename;\n    item.binary.data.fileExtension = ext;\n  }\n}\nreturn items;"
      },
      "id": "force-name-corvus2",
      "name": "Forçar Nome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [496, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $('Webhook Transcribe').item.json.body.model || 'gpt-4o-transcribe' }}"
            },
            {
              "name": "language",
              "value": "={{ $('Webhook Transcribe').item.json.body.language || 'pt' }}"
            },
            {
              "name": "response_format",
              "value": "json"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "transcribe-openai-corvus2",
      "name": "Transcrever (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 320],
      "credentials": {
        "openAiApi": {
          "id": "OBylh3PHUYnyQB0n",
