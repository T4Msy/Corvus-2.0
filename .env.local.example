# ───────────────────────────────────────────────
# Corvus V3 — exemplo de variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commitar.
# ───────────────────────────────────────────────

# ── n8n (server-side only — nunca exposto ao browser) ──────────────
# URL completa do webhook. Ex: https://n8n.seudominio.com/webhook/corvus-ingestao
N8N_WEBHOOK_URL=

# Opcional: header secreto que o webhook do n8n exige (se você habilitar
# "Header Auth" no node Webhook). Recomendado para produção.
N8N_WEBHOOK_SECRET=

# Opcional: API do n8n (para inspeção/management — não usado em runtime).
# N8N_API_URL=https://n8n.seudominio.com/api/v1
# N8N_API_KEY=

# Timeout em ms para chamadas ao n8n (default 30000).
N8N_TIMEOUT_MS=30000

# Retries em erros transitórios (default 2).
N8N_MAX_RETRIES=2

# Opcional: webhook DEDICADO de transcrição de áudio no n8n. Quando preenchido,
# o ditado/transcrição roda NO n8n (usando a credencial OpenAI do próprio n8n),
# e o app dispensa OPENAI_API_KEY para áudio. Vazio ⇒ usa OpenAI direto.
# Importe n8n/transcription-workflow.json e use o caminho do webhook aqui.
# Ex: https://n8n.seudominio.com/webhook/corvus-transcribe
N8N_TRANSCRIPTION_WEBHOOK_URL=

# OpenAI server-side. Usado para visão fallback, áudio anexado e ditado.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Opcional: se true, o Next tenta analisar imagens como fallback server-side.
# O padrão recomendado é deixar false/vazio e usar o Vision Analyzer do n8n.
CORVUS_SERVER_VISION_FALLBACK=false

# O áudio usa estes defaults se nada for configurado:
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# OPENAI_AUDIO_FALLBACK_MODEL=gpt-4o-mini
# AUDIO_STT_LANGUAGE=pt
# AUDIO_STT_LOCALE=pt-BR

# ── Supabase ───────────────────────────────────────────────────────
# Públicos (browser pode ver — anon key é desenhada pra ser pública).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Compatibilidade com installs antigos. O Next mapeia estes aliases para
# NEXT_PUBLIC_* no next.config.mjs, mas prefira os nomes acima em produção.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Service role — APENAS server-side. NUNCA prefixar com NEXT_PUBLIC_.
# Usado por API routes que precisam de acesso admin (não usado por padrão).
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────────────
# Origem permitida para chamadas de API (default: same-origin via Next).
# Em produção no Vercel, deixar em branco que o Next resolve.
# NEXT_PUBLIC_APP_URL=https://corvus.seudominio.com
